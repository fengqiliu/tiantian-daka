.ch { padding-top: 24rpx; }
.ch-head { padding: 0 32rpx 20rpx; }
.ch-label { margin: 8rpx 0 12rpx; }
.ch-chips, .ch-presets { display: flex; flex-wrap: wrap; gap: 14rpx; }
.ch-chip {
  background: #F7F2E8;
  color: #6B655B;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
}
.ch-chip.on { background: #FF6B81; color: #fff; font-weight: 600; }
.ch-link {
  margin-top: 20rpx;
  background: #FFF1F3;
  border-radius: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 27rpx;
}
.ch-unlink { color: #9A948B; font-size: 24rpx; padding-left: 16rpx; }
.ch-input {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  margin-top: 20rpx;
  background: #FFF9EF;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
}
.ch-count { text-align: right; margin: 6rpx 0 4rpx; }
.ch-preset {
  background: #fff;
  border: 2rpx solid #FFE0B8;
  border-radius: 16rpx;
  padding: 10rpx 18rpx;
  font-size: 26rpx;
}
.ch-preset:active { background: #FFF1DC; }
.btn-primary.off { opacity: 0.5; }
.ch-tip { text-align: center; margin-top: 14rpx; }
.ch-sent { padding: 14rpx 0; border-bottom: 1rpx solid #F3EDE2; }
.ch-sent-text { font-size: 28rpx; font-weight: 600; }
.ch-read { font-size: 22rpx; color: #9A948B; }
.ch-read.on { color: #2F9E44; }
.ch-reply { font-size: 26rpx; color: #FF6B81; font-weight: 600; }
