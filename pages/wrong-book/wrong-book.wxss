.wb { padding-top: 24rpx; }
.wb-head { padding: 0 32rpx 16rpx; }
.wb-sec { margin-bottom: 14rpx; }
.wb-clear { color: #FF5A3C; font-size: 26rpx; padding: 4rpx 0 4rpx 16rpx; }
.wb-group { padding: 8rpx 0 4rpx; }
.wb-item {
  background: #FFF9EF;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
}
.wb-text { font-size: 30rpx; font-weight: 600; }
.wb-answer { color: #2F9E44; font-size: 26rpx; font-weight: 600; padding: 0 14rpx; }
.wb-count { color: #B4884F; font-size: 24rpx; }
.wb-empty { text-align: center; padding: 12rpx 0; }
.wb-due { color: #9A948B; font-size: 22rpx; margin-top: 4rpx; }
.wb-review { margin: 0 32rpx 20rpx; }

.wb-group-row { align-items: center; }
.wb-practice { font-size: 24rpx; color: #FF8A00; padding: 8rpx 0 8rpx 16rpx; }
.wb-hint { margin-top: 6rpx; font-size: 24rpx; color: #8A5A00; }

.wb-export { margin-bottom: 20rpx; }

.wb-filters { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 20rpx; }
.wb-chip {
  background: #F7F2E8;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  font-size: 26rpx;
  color: #6B655B;
}
.wb-chip.on { background: #FF8A00; color: #fff; font-weight: 600; }
.wb-chip.due { margin-left: 8rpx; }
