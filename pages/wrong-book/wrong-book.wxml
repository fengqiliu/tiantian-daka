<view class="wb safe-bottom">
  <view class="wb-head">
    <view class="h1">❌ 错题本</view>
    <view class="muted" wx:if="{{readOnly}}">孩子的错题与复习进度（只读，孩子手机同步后更新）</view>
    <view class="muted" wx:else>错题按 1/3/7 天间隔安排复习，连对 3 次自动移出；练习时也会混入重练</view>
  </view>

  <view class="btn-primary wb-review" wx:if="{{dueCount}}" bindtap="goReview">🧠 去复习（{{dueCount}} 题到期）</view>
  <view class="btn-ghost wb-export" wx:if="{{mathCount || quizCount}}" bindtap="onExport">📋 复制全部错题（粘贴到文档打印）</view>

  <view class="wb-filters" wx:if="{{mathCount || quizCount}}">
    <view wx:for="{{subjectOptions}}" wx:key="key" class="wb-chip {{filters.subject === item.key ? 'on' : ''}}" data-key="{{item.key}}" bindtap="onFilterSubject">{{item.name}}</view>
    <view class="wb-chip due {{filters.dueOnly ? 'on' : ''}}" bindtap="onToggleDue">只看到期</view>
  </view>

  <view class="card">
    <view class="row wb-sec">
      <view class="h2 flex1">🧮 口算错题（{{mathCount}}）</view>
      <view class="wb-clear" bindtap="onClearMath" wx:if="{{mathCount && !readOnly}}">清空</view>
    </view>
    <block wx:if="{{mathGroups.length}}">
      <view wx:for="{{mathGroups}}" wx:key="name" wx:for-item="grp">
        <view class="muted wb-group">{{grp.name}}</view>
        <view class="row wb-item" wx:for="{{grp.items}}" wx:key="key" wx:for-item="q">
          <view class="flex1">
            <view class="wb-text">{{q.text}}</view>
            <view class="wb-due">{{q.schedule}}</view>
            <view class="wb-hint" wx:if="{{q.hint}}">💡 {{q.hint}}</view>
          </view>
          <view class="wb-answer">答案 {{q.answer}}</view>
          <view class="wb-count">错 {{q.wrongCount}} 次</view>
        </view>
      </view>
    </block>
    <view wx:else class="muted wb-empty">{{emptyHint || "暂无错题，太棒了！🎉"}}</view>
  </view>

  <view class="card">
    <view class="row wb-sec">
      <view class="h2 flex1">📝 小卷错题（{{quizCount}}）</view>
      <view class="wb-clear" bindtap="onClearQuiz" wx:if="{{quizCount && !readOnly}}">清空</view>
    </view>
    <block wx:if="{{quizGroups.length}}">
      <view wx:for="{{quizGroups}}" wx:key="key" wx:for-item="grp">
        <view class="row wb-group-row">
          <view class="muted wb-group flex1">{{grp.name}}（{{grp.items.length}}）</view>
          <view class="wb-practice" wx:if="{{!readOnly}}" data-subject="{{grp.subject}}" data-unit="{{grp.unit}}" bindtap="onPracticeUnit">只练这组 ›</view>
        </view>
        <view class="row wb-item" wx:for="{{grp.items}}" wx:key="key" wx:for-item="q">
          <view class="flex1">
            <view class="wb-text">{{q.text}}</view>
            <view class="wb-due">{{q.schedule}}</view>
            <view class="wb-hint" wx:if="{{q.explain}}">💡 {{q.explain}}</view>
          </view>
          <view class="wb-answer">答案 {{q.answer}}</view>
          <view class="wb-count">错 {{q.wrongCount}} 次</view>
        </view>
      </view>
    </block>
    <view wx:else class="muted wb-empty">{{emptyHint || "暂无错题，太棒了！🎉"}}</view>
  </view>
</view>
