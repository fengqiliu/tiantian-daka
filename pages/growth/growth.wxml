<view class="gr safe-bottom">
  <view class="card gr-rank">
    <view class="row">
      <view class="flex1">
        <view class="muted">我的称号</view>
        <view class="gr-rank-name">{{rank.emoji}} {{rank.name}}</view>
      </view>
      <view class="gr-star-total">⭐ {{totalStars}}</view>
    </view>
    <view class="gr-bar">
      <view class="gr-bar-in" style="width: {{rank.pct}}%;"></view>
    </view>
    <view class="muted">{{rank.next ? '距「' + rank.next.name + '」还差 ' + (rank.next.min - totalStars) + ' ⭐' : '已是最高称号，太厉害啦！'}}</view>
  </view>

  <view class="card row">
    <view class="gr-kpi flex1">
      <view class="gr-kpi-num">🔥 {{streak.current}}</view>
      <view class="muted">连续打卡（天）</view>
    </view>
    <view class="gr-kpi flex1">
      <view class="gr-kpi-num">🏅 {{streak.best}}</view>
      <view class="muted">最长连击（天）</view>
    </view>
    <view class="gr-kpi flex1">
      <view class="gr-kpi-num">✅ {{week.achieved}}/{{week.days}}</view>
      <view class="muted">本周达成</view>
    </view>
  </view>

  <view class="card row quiz-entry" bindtap="goQuiz">
    <view class="flex1">
      <view class="h2">📝 每周一卷</view>
      <view class="muted">{{quizHint}}</view>
    </view>
    <view class="quiz-go">开始 ›</view>
  </view>

  <view class="card row quiz-entry" wx:if="{{role === 'child'}}" bindtap="goFlashcards">
    <view class="flex1">
      <view class="h2">🃏 记忆卡</view>
      <view class="muted">语文生字 + 英语单词，翻卡自测</view>
    </view>
    <view class="quiz-go">练习 ›</view>
  </view>

  <view class="card row quiz-entry" bindtap="goWrongBook">
    <view class="flex1">
      <view class="h2">❌ 错题本</view>
      <view class="muted">{{wrongHint}}</view>
    </view>
    <view class="quiz-go">查看 ›</view>
  </view>

  <view class="card row quiz-entry" bindtap="goTerm">
    <view class="flex1">
      <view class="h2">📖 学期成长报告</view>
      <view class="muted">{{termHint}}</view>
    </view>
    <view class="quiz-go">查看 ›</view>
  </view>

  <view class="card row quiz-entry" wx:if="{{role === 'child'}}" bindtap="goShop">
    <view class="flex1">
      <view class="h2">🎁 奖励小铺</view>
      <view class="muted">{{shopHint}}</view>
    </view>
    <view class="quiz-go">兑换 ›</view>
  </view>

  <view class="sec-header row" style="padding: 8rpx 32rpx 16rpx;">
    <text class="h2">本周都在忙什么</text>
  </view>
  <view class="card" wx:if="{{bars.length}}">
    <view wx:for="{{bars}}" wx:key="key" class="bar row">
      <view class="bar-name">{{item.name}}</view>
      <view class="bar-track flex1">
        <view class="bar-in" style="width: {{item.pct}}%; background: {{item.color}};"></view>
      </view>
      <view class="bar-count muted">{{item.count}} 次</view>
    </view>
  </view>
  <view wx:else class="card empty muted">本周还没有打卡记录，快去开始吧！</view>

  <view class="sec-header row" style="padding: 8rpx 32rpx 16rpx;">
    <text class="h2 flex1">📈 我的进步</text>
    <text class="muted">{{trendLine}}</text>
  </view>
  <view class="card tr-card">
    <view class="tr-bars">
      <view class="tr-col" wx:for="{{trend}}" wx:key="monday">
        <view class="tr-acc">{{item.accuracy === null ? '' : item.accuracy + '%'}}</view>
        <view class="tr-track"><view class="tr-bar" style="height: {{item.starPct}}%;"></view></view>
        <view class="tr-num">{{item.stars}}</view>
        <view class="muted tr-label">{{item.label}}</view>
      </view>
    </view>
    <view class="muted tr-tip">柱子是每周的星星，上面的百分比是那周小卷的正确率</view>
  </view>

  <view class="sec-header row" style="padding: 8rpx 32rpx 16rpx;">
    <text class="h2">🗺️ 单元星图</text>
  </view>
  <view class="card" wx:for="{{starMap}}" wx:key="subject" wx:for-item="sub">
    <view class="row sm-head">
      <view class="h2 flex1">{{sub.name}}</view>
      <view class="muted">{{sub.summary}}</view>
    </view>
    <view class="sm-grid">
      <view class="sm-unit {{u.stars ? 'lit' : ''}}" wx:for="{{sub.units}}" wx:key="unit" wx:for-item="u"
        data-subject="{{sub.subject}}" data-unit="{{u.unit}}" bindtap="onStarUnit">
        <view class="sm-label">{{u.label}}</view>
        <view class="sm-stars">{{u.starText}}</view>
      </view>
    </view>
  </view>
  <view class="muted sm-tip">🃏 {{flashLine}}</view>
  <view class="muted sm-tip">小卷答满 3 题点亮 1 颗星；正确率 80% 以上 2 颗、90% 以上 3 颗。一科全部单元 2 颗星得「单元点灯人」勋章</view>

  <view class="sec-header row" style="padding: 8rpx 32rpx 16rpx;">
    <text class="h2">勋章墙</text>
  </view>
  <view class="wall">
    <view wx:for="{{wall}}" wx:key="id" class="badge {{item.earned ? 'on' : ''}}">
      <view class="badge-emoji">{{item.earned ? item.emoji : '❓'}}</view>
      <view class="badge-name">{{item.name}}</view>
      <view class="badge-desc muted">{{item.earned ? '已获得 🎉' : item.desc}}</view>
      <view class="badge-bonus" wx:if="{{item.bonus > 0}}">+{{item.bonus}} ⭐</view>
    </view>
  </view>
</view>
