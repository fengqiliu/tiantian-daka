.gr-rank { padding: 32rpx; }
.gr-rank-name { font-size: 44rpx; font-weight: 700; margin-top: 4rpx; }
.gr-star-total { font-size: 44rpx; font-weight: 700; color: #FF8A00; }
.gr-bar { height: 20rpx; background: #FFF1DC; border-radius: 999rpx; margin: 24rpx 0 12rpx; overflow: hidden; }
.gr-bar-in { height: 100%; background: linear-gradient(90deg, #FFB25A, #FF8A00); border-radius: 999rpx; }

.gr-kpi { text-align: center; }
.gr-kpi-num { font-size: 40rpx; font-weight: 700; }

.bar { margin-bottom: 20rpx; }
.bar:last-child { margin-bottom: 0; }
.bar-name { width: 88rpx; font-size: 26rpx; }
.bar-track { height: 24rpx; background: #F7F2E8; border-radius: 999rpx; margin: 0 16rpx; overflow: hidden; }
.bar-in { height: 100%; border-radius: 999rpx; min-width: 8rpx; }
.bar-count { width: 96rpx; text-align: right; }

.empty { text-align: center; }

.quiz-entry { padding: 26rpx 28rpx; }
.quiz-go { color: #FF8A00; font-weight: 600; font-size: 28rpx; padding-left: 16rpx; }

.wall { display: flex; flex-wrap: wrap; padding: 0 12rpx; }
.badge {
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx;
}
.badge-emoji {
  width: 110rpx; height: 110rpx;
  margin: 0 auto;
  background: #F1EBDD;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 56rpx;
  filter: grayscale(1);
  opacity: 0.5;
}
.badge.on .badge-emoji { background: #FFF4D6; filter: none; opacity: 1; }
.badge-name { text-align: center; font-size: 26rpx; font-weight: 600; margin-top: 12rpx; }
.badge-desc { text-align: center; font-size: 20rpx; line-height: 1.4; min-height: 56rpx; }
.badge-bonus {
  text-align: center;
  margin-top: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #FF8A00;
}

.sm-head { margin-bottom: 16rpx; }
.sm-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.sm-unit {
  width: calc((100% - 42rpx) / 4);
  background: #F7F2E8;
  border-radius: 18rpx;
  padding: 14rpx 0;
  text-align: center;
}
.sm-unit.lit { background: #FFF4D6; }
.sm-label { font-size: 24rpx; color: #6B655B; }
.sm-stars { font-size: 28rpx; color: #F59F00; letter-spacing: 2rpx; }
.sm-tip { padding: 0 32rpx 24rpx; font-size: 22rpx; }

.tr-bars { display: flex; align-items: flex-end; justify-content: space-between; height: 260rpx; }
.tr-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; }
.tr-acc { font-size: 20rpx; color: #2F9E44; height: 28rpx; }
.tr-track { flex: 1; width: 36rpx; display: flex; align-items: flex-end; background: #F7F2E8; border-radius: 10rpx; overflow: hidden; }
.tr-bar { width: 100%; background: linear-gradient(180deg, #FFB25A, #FF8A00); border-radius: 10rpx; }
.tr-num { font-size: 22rpx; color: #33302B; margin-top: 4rpx; }
.tr-label { font-size: 20rpx; }
.tr-tip { font-size: 22rpx; margin-top: 12rpx; }
