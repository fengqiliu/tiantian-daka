<view class="pf safe-bottom">
  <view class="card row pf-head">
    <view class="pf-avatar">{{avatar}}</view>
    <view class="flex1">
      <view class="h2">{{nickname}} <text class="role-tag">{{role === 'parent' ? '家长模式 👀' : '孩子模式 🎒'}}</text></view>
      <view class="muted" wx:if="{{role === 'child'}}">上海 · {{grade}} 年级{{school ? ' · ' + school : ''}}</view>
      <view class="muted" wx:else>只读查看绑定孩子的打卡进度</view>
    </view>
  </view>

  <view class="card row" wx:if="{{role === 'child'}}">
    <view class="pf-stats flex1">
      <view class="muted">⭐ {{totalStars}} · 🔥 {{streak}} 天 · 📅 {{checkinDays}} 天</view>
    </view>
    <view class="pf-switch" bindtap="switchRole">切换为家长</view>
  </view>
  <view class="card row" wx:else>
    <view class="flex1">
      <view class="muted">当前绑定的孩子</view>
      <view class="h2" wx:if="{{childInfo}}">{{childInfo.avatar}} {{childInfo.nickname}} · {{childInfo.grade}} 年级</view>
      <view class="muted" wx:else>尚未绑定，可在首页输入邀请码</view>
    </view>
    <view class="pf-switch" bindtap="unbind" wx:if="{{childInfo}}">解绑</view>
    <view class="pf-switch" bindtap="switchRole">切换为孩子</view>
  </view>

  <view class="card" wx:if="{{role === 'child'}}">
    <view class="h2" style="margin-bottom: 24rpx;">家人绑定</view>
    <block wx:if="{{cloudOn}}">
      <view class="code-box" bindtap="copyCode">
        <text class="code-num">{{familyCode || '······'}}</text>
        <text class="muted">{{familyCode ? '点击复制邀请码' : '正在生成…'}}</text>
      </view>
      <view class="btn-ghost" style="margin-top: 20rpx;" bindtap="checkCloud">检测云端连接</view>
      <view class="muted" style="margin-top: 16rpx;">家长在自己手机上打开本小程序，输入邀请码即可绑定，只读查看你的打卡进度。</view>
    </block>
    <view wx:else class="muted">家人绑定需要先开通微信云开发，步骤见项目 README（未开通不影响打卡）。</view>
  </view>

  <view class="card" wx:if="{{role === 'child'}}">
    <view class="h2" style="margin-bottom: 12rpx;">每日打卡提醒</view>
    <view class="muted" wx:if="{{remindText}}">{{remindText}}</view>
    <block wx:if="{{cloudOn}}">
      <view class="btn-primary" style="margin-top: 24rpx;" bindtap="subscribeRemind">🔔 开启 / 续订提醒（每天 20:00）</view>
      <view class="muted" style="margin-top: 12rpx;">微信规定每次授权可提醒一次，授权最多累计 3 次；提醒次数用完后再来点一下即可。</view>
    </block>
    <view wx:else class="muted" style="margin-top: 8rpx;">提醒功能需开通云开发后使用。</view>
  </view>

  <view class="card" wx:if="{{role === 'parent'}}">
    <view class="h2" style="margin-bottom: 12rpx;">接收孩子动态</view>
    <block wx:if="{{cloudOn}}">
      <view class="muted">孩子获得新勋章、达成连续打卡里程碑时微信通知你。</view>
      <view class="btn-primary" style="margin-top: 24rpx;" bindtap="subscribeParent">🔔 订阅孩子动态通知</view>
    </block>
    <view wx:else class="muted">通知功能需开通云开发后使用。</view>
  </view>

  <view class="card">
    <view class="h2" style="margin-bottom: 24rpx;">{{role === 'parent' ? '家长资料' : '孩子资料'}}</view>
    <view class="field">
      <view class="muted">昵称</view>
      <input class="input" value="{{nickname}}" bindinput="onNickname" maxlength="12" />
    </view>
    <view class="field">
      <view class="muted">头像</view>
      <view class="avatar-row">
        <view
          wx:for="{{avatars}}"
          wx:key="*this"
          class="avatar {{avatar === item ? 'on' : ''}}"
          data-emoji="{{item}}"
          bindtap="pickAvatar"
        >{{item}}</view>
      </view>
    </view>
    <block wx:if="{{role === 'child'}}">
      <view class="field">
        <view class="muted">年级（切换后每日任务会自动调整）</view>
        <view class="grade-row">
          <view
            wx:for="{{grades}}"
            wx:key="*this"
            class="grade-btn {{grade === item ? 'on' : ''}}"
            data-grade="{{item}}"
            bindtap="pickGrade"
          >{{item}}年级</view>
        </view>
      </view>
      <view class="field">
        <view class="muted">学校（选填）</view>
        <input class="input" placeholder="如：上海市××小学" value="{{school}}" bindinput="onSchool" maxlength="30" />
      </view>
    </block>
    <view class="btn-primary" style="margin-top: 32rpx;" bindtap="save">保存资料</view>
  </view>

  <view class="card" wx:if="{{role === 'child'}}">
    <view class="h2" style="margin-bottom: 12rpx;">任务管理（家长）</view>
    <view class="muted" style="margin-bottom: 20rpx;">任务量不合适？在这里调整每日目标或添加自定义任务（如练钢琴）。</view>
    <view class="btn-ghost" bindtap="goTaskManage">🛠 调整任务目标 / 添加自定义任务</view>
  </view>

  <view class="card">
    <view class="h2" style="margin-bottom: 24rpx;">数据</view>
    <view class="btn-ghost" bindtap="exportData">导出数据（复制 JSON 备份）</view>
    <view class="btn-danger" style="margin-top: 20rpx;" bindtap="clearData">清空所有数据</view>
    <view class="muted" style="margin-top: 20rpx;">打卡数据保存在本机；开通云开发后自动加密同步备份，仅自己与绑定的家人可见。</view>
  </view>

  <view class="pf-foot muted">天天小达人 v{{version}} · 内容依据沪教版课程与“双减”等要求设计</view>
</view>
