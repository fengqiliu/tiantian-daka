.ob { display: flex; flex-direction: column; min-height: 100vh; padding: 0 48rpx calc(env(safe-area-inset-bottom) + 40rpx); box-sizing: border-box; }
.ob-body { flex: 1; padding-top: 120rpx; }
.ob-logo { font-size: 120rpx; text-align: center; }
.ob-title { text-align: center; margin-top: 16rpx; }
.ob-slogan { text-align: center; margin-top: 8rpx; white-space: pre-line; }
.ob-points { margin-top: 72rpx; }
.ob-point { background: #fff; border-radius: 20rpx; padding: 22rpx 28rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.ob-sub { margin: 8rpx 0 40rpx; }
.ob-btn { margin-top: 40rpx; }

.grade-grid { display: flex; justify-content: space-between; }
.grade-btn {
  width: 108rpx; height: 108rpx;
  border-radius: 32rpx;
  background: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 700;
  color: #6B655B;
  border: 3rpx solid transparent;
}
.grade-btn.on { background: #FFF1DC; color: #FF8A00; border-color: #FFB25A; }
.grade-hint { text-align: center; margin-top: 28rpx; min-height: 40rpx; }

.avatar-row { display: flex; justify-content: space-between; margin: 40rpx 0; }
.avatar {
  width: 88rpx; height: 88rpx;
  background: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
  border: 3rpx solid transparent;
}
.avatar.on { border-color: #FFB25A; background: #FFF1DC; }

.role-cards { margin-top: 72rpx; }
.role-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 31, 0.07);
}
.role-emoji { font-size: 56rpx; }
.role-name { font-size: 32rpx; font-weight: 700; margin: 8rpx 0 4rpx; }

.field { margin-top: 32rpx; }
.input {
  background: #fff;
  border-radius: 20rpx;
  padding: 22rpx 28rpx;
  margin-top: 12rpx;
  font-size: 30rpx;
}
