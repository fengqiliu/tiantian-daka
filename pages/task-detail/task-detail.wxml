<view class="td" wx:if="{{task}}">
  <view class="card td-head">
    <view class="row">
      <view class="td-emoji" style="background: {{secBg}};">{{task.emoji}}</view>
      <view class="flex1">
        <view class="h1">{{task.name}}<text wx:if="{{task.must}}" class="tag-must">必做</text></view>
        <view class="muted">{{secName}} · {{dateLabel}}</view>
      </view>
    </view>
    <view class="td-desc">{{task.desc}}</view>
  </view>

  <view class="card">
    <view class="h2 td-sec-title">{{makeup ? '那天完成了多少？' : '今天完成了多少？'}}</view>

    <view class="tm" wx:if="{{canTime}}">
      <block wx:if="{{timer}}">
        <view class="tm-clock {{timer.overtime ? 'over' : ''}}">{{timer.clock}}</view>
        <view class="muted tm-sub">{{timer.overtime ? '已达到目标，继续也可以' : '距离目标 ' + task.target + ' 分钟'}} · 已计 {{timer.minutes}} 分钟{{timer.paused ? ' · 已暂停' : ''}}</view>
        <view class="tm-track"><view class="tm-in {{timer.overtime ? 'over' : ''}}" style="width: {{timer.pct}}%;"></view></view>
        <view class="tm-btns row">
          <view class="tm-btn" wx:if="{{!timer.paused}}" bindtap="onTimerPause">⏸ 暂停</view>
          <view class="tm-btn" wx:else bindtap="onTimerResume">▶️ 继续</view>
          <view class="tm-btn primary" bindtap="onTimerStop">⏹ 结束并填入</view>
        </view>
        <view class="tm-cancel muted" bindtap="onTimerCancel">放弃这次计时</view>
      </block>
      <block wx:elif="{{timerBusy}}">
        <view class="muted tm-sub">「{{timerBusy}}」正在计时，结束后才能开始新的</view>
      </block>
      <view wx:else class="tm-start" bindtap="onTimerStart">⏱ 开始计时（目标 {{task.target}} 分钟）</view>
    </view>

    <block wx:if="{{task.type !== 'done'}}">
      <view class="stepper row">
        <view class="step-btn" bindtap="onMinus">−</view>
        <view class="step-num">{{value}} <text class="muted">{{task.unit}}</text></view>
        <view class="step-btn" bindtap="onPlus">＋</view>
      </view>
      <view class="chips" wx:if="{{steps.length}}">
        <view
          wx:for="{{steps}}"
          wx:key="*this"
          class="chip {{value === item ? 'on' : ''}}"
          data-n="{{item}}"
          bindtap="onStep"
        >{{item}}</view>
      </view>
      <view class="muted td-hint">目标 {{task.target}} {{task.unit}}{{task.type === 'count' ? '，可以分几次完成' : ''}}</view>
    </block>

    <block wx:else>
      <view class="done-box {{value > 0 ? 'on' : ''}}" bindtap="onStep">✅ 完成啦</view>
    </block>
  </view>

  <view class="card">
    <view class="h2 td-sec-title">{{makeup ? '补打卡' : '给自己评个星'}}</view>
    <view class="muted" wx:if="{{makeup}}" style="margin-bottom: 16rpx;">补卡固定 1 ⭐，需要家长确认；能接上连击，但那天不再有"全部完成"加成</view>
    <view class="mood-row row" wx:else>
      <view
        wx:for="{{moods}}"
        wx:key="stars"
        class="mood {{stars === item.stars ? 'on' : ''}}"
        data-stars="{{item.stars}}"
        bindtap="onStar"
      >
        <view class="mood-emoji">{{item.emoji}}</view>
        <view class="mood-label">{{item.label}}</view>
        <view class="mood-stars">{{item.stars}} ⭐</view>
      </view>
    </view>
    <view class="field">
      <view class="muted">一句话记录（选填）</view>
      <input class="input" placeholder="比如：今天跳绳比昨天快！" value="{{note}}" bindinput="onNote" maxlength="50" />
    </view>
  </view>

  <view class="td-actions">
    <view class="btn-primary" bindtap="onSave">{{exists ? '更新打卡' : '保存打卡'}} ⭐{{stars}}</view>
    <view wx:if="{{task.id === 'chinese_poem'}}" class="btn-ghost td-remove" bindtap="goPoems">📜 古诗背诵库</view>
    <view wx:if="{{task.id === 'english_listen'}}" class="btn-ghost td-remove" bindtap="goReadAloud">🎧 进入跟读教室</view>
    <view wx:if="{{task.id === 'math_calc'}}" class="btn-ghost td-remove" bindtap="goMathDrill">🧮 进入口算挑战</view>
    <view wx:if="{{exists}}" class="btn-danger td-remove" bindtap="onRemove">取消本次打卡</view>
  </view>
</view>
