.td { padding-top: 24rpx; padding-bottom: calc(env(safe-area-inset-bottom) + 40rpx); }
.td-head { padding: 32rpx; }
.td-emoji {
  width: 108rpx; height: 108rpx;
  border-radius: 32rpx;
  font-size: 56rpx;
  display: flex; align-items: center; justify-content: center;
  margin-right: 28rpx;
}
.td-desc { margin-top: 24rpx; color: #6B655B; font-size: 26rpx; background: #FFF9EF; border-radius: 16rpx; padding: 20rpx; }
.td-sec-title { margin-bottom: 24rpx; }

.stepper { justify-content: center; margin: 16rpx 0 8rpx; }
.step-btn {
  width: 88rpx; height: 88rpx;
  background: #FFF1DC;
  color: #FF8A00;
  border-radius: 50%;
  font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
  font-weight: 700;
}
.step-num { min-width: 220rpx; text-align: center; font-size: 52rpx; font-weight: 700; }

.chips { display: flex; flex-wrap: wrap; gap: 16rpx; justify-content: center; margin-top: 20rpx; }
.chip { background: #F7F2E8; border-radius: 999rpx; padding: 12rpx 32rpx; font-size: 28rpx; color: #6B655B; }
.chip.on { background: #FF8A00; color: #fff; font-weight: 600; }
.td-hint { text-align: center; margin-top: 20rpx; }

.done-box {
  text-align: center;
  border: 3rpx dashed #EADFCB;
  border-radius: 20rpx;
  padding: 32rpx;
  font-size: 34rpx;
  color: #B4884F;
}
.done-box.on { border-style: solid; background: #E8F8EC; color: #2F9E44; border-color: #8CD9A0; }

.mood-row { justify-content: space-between; }
.mood {
  flex: 1;
  background: #F7F2E8;
  border-radius: 24rpx;
  padding: 20rpx 0;
  text-align: center;
  margin-right: 16rpx;
  border: 3rpx solid transparent;
}
.mood:last-child { margin-right: 0; }
.mood.on { background: #FFF1DC; border-color: #FFB25A; }
.mood-emoji { font-size: 52rpx; }
.mood-label { font-size: 26rpx; font-weight: 600; margin-top: 6rpx; }
.mood-stars { font-size: 22rpx; color: #B4884F; }

.field { margin-top: 28rpx; }
.input { background: #F7F2E8; border-radius: 16rpx; padding: 20rpx 24rpx; margin-top: 10rpx; font-size: 28rpx; }

.td-actions { margin: 32rpx 24rpx 0; }
.td-remove { margin-top: 20rpx; }
